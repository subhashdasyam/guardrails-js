{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 10,
            "statusMessage": "guardrails-js reading your stack",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/dist/session-start.mjs"
            ]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "async": true,
            "asyncRewake": true,
            "timeout": 20,
            "statusMessage": "guardrails-js scanning",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/dist/post-write.mjs"
            ]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 10,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/dist/pre-bash.mjs"
            ]
          }
        ]
      }
    ]
  }
}
